# ─── Data source ────────────────────────────────────────────────
# "auto" (default): live when BUILDER_CODES_API_URL is set, otherwise preview.
# "preview": deterministic sample data (clearly labelled in the UI).
# "live": always call the Builder Codes API; shows "unavailable" on failure,
#         never falls back to sample numbers.
METRICS_MODE=auto

# Full URL of the Builder Codes stats endpoint (returns per-builder records).
BUILDER_CODES_API_URL=
# Optional — sent as both `x-api-key` and `Authorization: Bearer`.
BUILDER_CODES_API_KEY=
# Optional — set if revenue is returned in raw token units (e.g. 6 for vUSDC).
BUILDER_CODES_REVENUE_DECIMALS=
# Optional — same for volume; defaults to the revenue decimals.
BUILDER_CODES_VOLUME_DECIMALS=

# ─── Site ───────────────────────────────────────────────────────
# Canonical URL for OG images and metadata. On Vercel this falls back to
# VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=
# Optional race end time (ISO 8601) — shows a countdown in the hero.
# NEXT_PUBLIC_RACE_ENDS_AT=2026-11-30T23:59:59Z
