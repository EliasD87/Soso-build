# ─── Data source ────────────────────────────────────────────────
# Source on first load; visitors can flip it with the Prototype / Live toggle.
# "preview" (default): deterministic sample data.
# "live": SoDEX builder statistics for every project with a `builderAddress`
#         in src/data/projects.ts. Never falls back to sample numbers.
METRICS_MODE=preview

# Optional — SoDEX public REST base. Defaults to Mainnet.
# Testnet: https://testnet-gw.sodex.dev/api/v1
SODEX_API_URL=

# ─── Site ───────────────────────────────────────────────────────
# Canonical URL for OG images and metadata. On Vercel this falls back to
# VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=
# Optional race end time (ISO 8601) — shows a countdown in the hero.
# NEXT_PUBLIC_RACE_ENDS_AT=2026-11-30T23:59:59Z
